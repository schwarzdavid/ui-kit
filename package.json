    "sass": "1.105.1",
    "storybook": "10.6.2",
    "type-fest": "5.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.0.5",
