{
  "name": "@schwarzdavid/ui-kit",
  "version": "0.0.1-alpha.17",
  "type": "module",
  "scripts": {
    "preview": "vite preview",
    "check": "vue-tsc --build --force",
    "docs": "storybook dev -p 6006 --no-open",
    "build:lib": "vue-tsc && vite build",
    "build:docs": "storybook build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run build:lib",
    "update:version": "npm version prerelease --preid alpha"
  },
  "author": "David Schwarz <david@ists-wurscht.at>",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "import": "./dist/main.js",
      "types": "./dist/main.d.ts"
    },
    "./validators": {
      "import": "./dist/validators.js",
      "types": "./dist/validators.d.ts"
    },
    "./styles": {
      "import": "./dist/ui-kit.css"
    }
  },
  "peerDependencies": {
    "@vuelidate/core": ">=2",
    "pinia": ">=2",
    "vue": ">=3",
    "vue-i18n": ">=9",
    "vuetify": ">=3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.1.1",
    "@eslint/js": "10.0.1",
    "@intlify/unplugin-vue-i18n": "11.0.7",
    "@laynezh/vite-plugin-lib-assets": "2.1.3",
    "@mdi/font": "7.4.47",
    "@storybook/addon-links": "10.3.5",
    "@storybook/addon-onboarding": "10.3.5",
    "@storybook/vue3-vite": "10.3.5",
    "@stylistic/eslint-plugin": "2.13.0",
    "@tsconfig/node24": "24.0.4",
    "@types/jsdom": "28.0.1",
    "@types/lodash": "4.17.24",
    "@types/node": "24.1.0",
    "@types/uuid": "11.0.0",
    "@vitejs/plugin-vue": "6.0.6",
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "@vitest/eslint-plugin": "1.6.15",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.9.1",
    "@vuelidate/core": "2.0.3",
    "eslint": "10.2.0",
    "eslint-plugin-vue": "10.8.0",
    "jsdom": "29.0.2",
    "pinia": "3.0.4",
    "sass": "1.99.0",
    "storybook": "10.3.5",
    "type-fest": "5.5.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.1",
    "vite": "8.0.8",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.1.4",
    "vue-component-type-helpers": "3.2.6",
    "vue-eslint-parser": "10.4.0",
    "vue-i18n": "11.3.2",
    "vue-tsc": "3.2.6",
    "vuetify": "4.0.5",
    "eslint-plugin-storybook": "10.3.5",
    "@storybook/addon-docs": "10.3.5"
  },
  "dependencies": {
    "@vuelidate/validators": "^2.0.4",
    "lodash": "^4.17.21",
    "uuid": "^11.0.5"
  },
  "overrides": {
    "vite": "8.0.8"
  }
}
