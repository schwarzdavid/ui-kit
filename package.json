    "@chromatic-com/storybook": "5.5.1",
    "@eslint/js": "10.0.1",
    "@intlify/unplugin-vue-i18n": "11.2.6",
    "@laynezh/vite-plugin-lib-assets": "2.1.3",
    "@mdi/font": "7.4.47",
    "@microsoft/api-extractor": "7.59.4",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-links": "10.6.2",
    "@storybook/addon-onboarding": "10.6.2",
    "@storybook/vue3-vite": "10.6.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/lodash": "4.17.26",
    "@types/node": "26.6.5",
    "@types/uuid": "11.0.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "@vuelidate/core": "2.0.3",
    "eslint": "10.12.0",
