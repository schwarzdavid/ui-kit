{
  "name": "@schwarzdavid/ui-kit",
  "version": "0.0.1-alpha.17",
  "description": "Vue 3 + Vuetify composables and components for dialogs, toasts, loading states and Vuelidate helpers",
  "keywords": [
    "vue",
    "vue3",
    "vuetify",
    "composables",
    "dialog",
    "toast",
    "vuelidate",
    "ui-kit"
  ],
  "homepage": "https://github.com/schwarzdavid/ui-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schwarzdavid/ui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/schwarzdavid/ui-kit/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "check": "vue-tsc --build --force",
    "docs": "storybook dev -p 6006 --no-open",
    "build:lib": "vue-tsc --build --force && vite build",
    "build:docs": "storybook build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "prepublishOnly": "npm run build:lib",
    "update:version": "npm version prerelease --preid alpha"
  },
  "author": "David Schwarz <david@ists-wurscht.at>",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./validators": {
      "types": "./dist/validators.d.ts",
      "import": "./dist/validators.js",
      "default": "./dist/validators.js"
    },
    "./vuetify": {
      "types": "./dist/vuetify.d.ts",
      "import": "./dist/vuetify.js",
      "default": "./dist/vuetify.js"
    },
    "./vuetify/settings.scss": "./dist/vuetify/settings.scss",
    "./vuetify/settings": "./dist/vuetify/settings.scss",
    "./styles": "./dist/ui-kit.css"
  },
  "peerDependencies": {
    "@vuelidate/core": "^2.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^9.0.0 || ^10.0.0 || ^11.0.0",
    "vuetify": "^3.0.0 || ^4.0.0"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "@vuelidate/validators": "^2.0.4",
    "lodash-es": "^4.18.1",
    "type-fest": "^5.10.0",
    "vue-component-type-helpers": "^3.3.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@intlify/unplugin-vue-i18n": "11.2.6",
    "@microsoft/api-extractor": "7.59.4",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/vue3-vite": "10.6.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "@vuelidate/core": "2.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-storybook": "10.6.2",
    "eslint-plugin-vue": "10.11.1",
    "jsdom": "30.1.3",
    "sass": "1.105.1",
    "storybook": "10.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-dts": "5.1.2",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-eslint-parser": "10.4.1",
    "vue-i18n": "11.4.14",
    "vue-tsc": "3.3.13",
    "vuetify": "4.2.6"
  },
  "overrides": {
    "vite": "8.3.4"
  }
}
